# Copy this file to .env and replace the placeholder with your local credentials.
DATABASE_URL=mysql+pymysql://USERNAME:PASSWORD@localhost:3306/ai_budget

# ----------------------------------------------------------------------------
# Docker 容器内使用的数据库地址（阶段 2-3）
# ----------------------------------------------------------------------------
# 容器里的 localhost 指向容器自身，连不到宿主机原生 MySQL(3306)。
# 这一条只把 host 换成 host.docker.internal（Docker Desktop 会解析到宿主机），
# 用户名 / 口令 / 端口 / 库名必须与上面的 DATABASE_URL 完全一致。
# docker-compose.yml 用 environment.DATABASE_URL=${DATABASE_URL_DOCKER} 覆盖注入，
# compose 文件里因此不需要出现任何明文口令。
# 上面的 DATABASE_URL 保持 localhost 不要改：本地直接跑 backend/venv 时仍需要它。
# 若未来把 MySQL 也容器化，则改成服务名（如 mysql:3306）并删除本变量。
# ----------------------------------------------------------------------------
DATABASE_URL_DOCKER=mysql+pymysql://USERNAME:PASSWORD@host.docker.internal:3306/ai_budget

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ============================================================================
# Agent 开关
# ----------------------------------------------------------------------------
# AGENT_ENABLED=true  : /chat 走 LangGraph Agent（推荐，新架构）
# AGENT_ENABLED=false : /chat 继续走 Dify（兼容旧版本）
# ============================================================================
AGENT_ENABLED=true

# ============================================================================
# LLM 配置（LangChain Agent 使用的模型）
# ----------------------------------------------------------------------------
# provider: openai | dashscope | deepseek
# - openai    : 通用 OpenAI 兼容协议（GPT-4o / DeepSeek / 月之暗面 / 智谱 等）
# - dashscope : 阿里云百炼 / 通义千问
#               注：dashscope 包已于阶段 2-3 从 requirements.txt 移除（V1.0 未使用）。
#               切回该 provider 前需先 `pip install dashscope` 并把实测版本钉回 requirements.txt。
# - deepseek  : DeepSeek 官方（OpenAI 兼容）
# ============================================================================
LLM_PROVIDER=openai
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3

# ----------------------------------------------------------------------------
# Dify 配置（已废弃，仅在 AGENT_ENABLED=false 时回退使用）
# ----------------------------------------------------------------------------
DIFY_API_URL=https://api.dify.ai/v1/chat-messages
DIFY_API_KEY=replace-with-your-dify-api-key
DIFY_TIMEOUT_SECONDS=60
DIFY_INTERNAL_API_KEY=replace-with-a-separate-long-random-internal-key
AGENT_API_KEY=replace-with-a-separate-long-random-agent-key
